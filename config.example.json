{
  "_comment": "Конфиг Bids_Gateway. Секция fields — реальные имена ключей из supply_requests.json (проверено на выгрузке orekeeper). Пути относительные, как у stock_gateway.",
  "queues": {
    "request_queue": "BidsManager_To_BidsGateway",
    "reply_queue": "BidsGateway_To_BidsManager"
  },
  "paths": {
    "bids_root": "../orekeeper/data/bid",
    "logs_root": "../orekeeper/logs/bid"
  },
  "reply": {
    "target_service": "Bids_Manager"
  },
  "fields": {
    "number": "Number",
    "date": "Date",
    "firm": "ZakazPodr",
    "firm2": "ZakupPodr",
    "name": "Name",
    "comment": "Details",
    "tovars": "Tovars",
    "tovar": "Tovar",
    "tovar2": "Tovar2"
  },
  "search": {
    "max_items": 50,
    "min_query_len": 2
  },
  "workers": {
    "min_threads": 2,
    "max_threads": 8,
    "poll_interval_ms": 50,
    "idle_timeout_sec": 30,
    "scale_up_backlog": 16
  },
  "watcher": {
    "check_interval_sec": 1800
  },
  "self_test": {
    "enabled": false,
    "keyword": "стрейч",
    "field": "any"
  },
  "logging": {
    "log_dir": "logs",
    "min_level": "INFO",
    "max_file_size_mb": 5,
    "max_file_age_sec": 3600,
    "retention_max_files": 100
  }
}
